#!/usr/bin/python3
# Alien Thunder's launcher. ~/.local/bin/alien-thunder links here, so the checkout is
# what runs. It uses the system Python on purpose: PySide6, dbus and gobject come
# from the distribution's packages.
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from alien_thunder.cli import main  # noqa: E402

sys.exit(main())
