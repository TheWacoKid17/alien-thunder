[Unit]
Description=AlienFX Studio - mantém a iluminação do Alienware m16 R2 aplicada
Documentation=file://%h/.local/src/alienfx-studio
After=dbus.socket

[Service]
Type=dbus
BusName=io.github.AlienFXStudio
ExecStart=%h/.local/bin/alienfx-studio daemon
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Nice=5

[Install]
WantedBy=default.target
