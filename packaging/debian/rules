#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	$(MAKE) locales

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) check
endif

override_dh_auto_install:
	$(MAKE) PREFIX=/usr DESTDIR=$(CURDIR)/debian/alien-thunder install
	rm -rf $(CURDIR)/debian/alien-thunder/usr/share/licenses
